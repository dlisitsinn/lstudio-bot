# ===== Настройки бота LStudio =====
# Значение пишется сразу после знака «=». Никому не пересылайте этот файл.

# --- Токен ВК (необязательно) ---
# Нужен для поиска во ВК и отправки сообщений одной кнопкой. Без него — поиск по карте и ручная отправка.
VK_USER_TOKEN=

# --- Почта, с которой уходят письма ---
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=Анастасия Селиванова, LStudio
# Сервер почты определяется сам для gmail / yandex / mail.ru. Для другой почты:
# SMTP_HOST=smtp.example.ru
# SMTP_PORT=465

# --- Кому писать ---
# да — оставлять только организации с группой ВК (почта, телефон и WhatsApp не нужны)
# нет — оставлять всех: с почтой — письмом, без почты — во ВК или WhatsApp
ONLY_VK=да

# --- Поиск ---
DEFAULT_CITY=Челябинск
# Группы ВК, где меньше подписчиков, пропускаются (обычно заброшенные)
MIN_MEMBERS=30

# --- Осторожность с рассылкой ---
# Писем в день. Первую неделю 10–15, потом до 25–30.
DAILY_EMAIL_LIMIT=15
# Сообщений во ВК в день (каждое отправляете вы кнопкой), до 5000. ВК сам ограничивает отправку незнакомым — обычно 20–40 в день с одной страницы.
VK_DAILY_LIMIT=2000
# Пауза между письмами, секунд
EMAIL_DELAY_MIN=60
EMAIL_DELAY_MAX=150

# --- Ссылки в письмах ---
PORTFOLIO_URL=https://dlisitsinn.github.io/
STUDIO_VK_URL=https://vk.ru/lssttudio

# --- Обновления ---
# Бот сам обновляется с GitHub при запуске. Чтобы выключить — AUTO_UPDATE=нет
AUTO_UPDATE=да
